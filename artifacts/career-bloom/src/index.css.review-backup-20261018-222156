/* CareerBloom Overview analytics */
.overview-analytics{display:grid;gap:18px;margin:0 0 30px}
.analytics-heading{display:flex;justify-content:space-between;align-items:center;gap:16px}
.analytics-heading h2{font-size:25px;margin:7px 0}
.analytics-heading p,.analytics-card-heading p{color:#9aa7c7;font-size:12px;margin:5px 0 0}
.analytics-period,.chart-tag{border:1px solid #303a59;background:#11182b;color:#aebde0;border-radius:9px;padding:9px 12px;font-size:11px;white-space:nowrap}
.analytics-card{background:linear-gradient(145deg,#11182a,#0d1424);border:1px solid #293451;border-radius:16px;padding:18px;min-width:0}
.analytics-card-heading{display:flex;justify-content:space-between;align-items:center;gap:10px}
.analytics-card-heading h3{font-size:14px;margin:0;color:#f1f5ff}
.overview-chart{width:100%;height:255px;margin-top:14px}
.subject-chart-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.subject-analytics-card{padding:15px}
.subject-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.subject-doughnut{height:145px;position:relative;margin-top:5px}
.doughnut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none}
.doughnut-center strong{font-size:23px;color:#f3f6ff}
.doughnut-center small,.radial-progress-row small{font-size:10px;color:#9aa7c7;margin-top:3px}
.radial-progress-row{border-top:1px solid #27314b;padding-top:12px;display:flex;align-items:center;gap:10px}
.radial-chart{width:45px;height:45px;flex-shrink:0}
.radial-progress-row b{font-size:11px;display:block;color:#eaf0ff}
.daily-hours-chart{height:270px}
.study-legend{display:flex;flex-wrap:wrap;gap:14px;margin-top:8px}
.study-legend span{font-size:11px;color:#aab6d2;display:flex;align-items:center;gap:6px}
.study-legend i{display:inline-block;width:8px;height:8px;border-radius:50%}
@media(max-width:1000px){.subject-chart-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.subject-chart-grid{grid-template-columns:1fr}.analytics-heading{align-items:flex-start;flex-direction:column}.overview-chart{height:220px}.daily-hours-chart{height:235px}.analytics-card{padding:13px}}

/* CareerBloom welcome animation and dream-career selection */
.career-onboarding{min-height:100vh;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;padding:28px 22px 36px;background:radial-gradient(ellipse at 15% 20%,rgba(103,67,190,.18),transparent 45%),#080d1b;color:#f4f6ff}
.onboarding-brand{width:min(100%,1040px);display:flex;align-items:center;gap:11px;font-weight:750;font-size:17px;position:relative;z-index:1}
.onboarding-glow{position:absolute;border-radius:50%;filter:blur(1px);pointer-events:none}
.onboarding-glow-one{width:420px;height:420px;top:5%;left:-230px;border:1px solid #342753;box-shadow:0 0 0 35px rgba(103,67,190,.04),0 0 0 70px rgba(103,67,190,.025)}
.onboarding-glow-two{width:480px;height:480px;right:-270px;bottom:-260px;border:1px solid #203b4c;box-shadow:0 0 0 40px rgba(40,130,150,.035)}
.welcome-animation{width:min(100%,760px);margin:auto;text-align:center;padding:65px 20px;animation:careerWelcomeIn .75s cubic-bezier(.2,.75,.25,1) both;position:relative;z-index:1}
.welcome-sparkle{width:78px;height:78px;display:grid;place-items:center;margin:0 auto 25px;border:1px solid #6b50b4;border-radius:25px;background:linear-gradient(145deg,#9b6bff,#5b36c7);box-shadow:0 0 55px #8755ff44;animation:careerSparkle 2.2s ease-in-out infinite}
.onboarding-eyebrow{display:flex;justify-content:center;align-items:center;gap:7px;color:#b69aff;font-size:11px;font-weight:800;letter-spacing:1.7px}
.welcome-animation h1,.career-picker h1{font-size:clamp(32px,5vw,52px);line-height:1.12;letter-spacing:-1.7px;margin:18px 0 14px}
.welcome-animation h1 span,.career-picker h1 span{background:linear-gradient(100deg,#c2a5ff,#8a72ff,#62c9ff);background-clip:text;-webkit-background-clip:text;color:transparent}
.welcome-animation p,.career-picker>p{max-width:560px;margin:0 auto;color:#a8b5d2;line-height:1.8;font-size:14px}
.onboarding-continue{margin-top:30px;display:inline-flex;align-items:center;gap:12px;padding:14px 20px}
.career-picker{position:relative;z-index:1;width:min(100%,850px);margin:45px auto 0;animation:careerWelcomeIn .5s ease both}
.career-picker h1,.career-picker>p{text-align:center}
.career-picker-search{margin:28px auto 14px;max-width:700px;display:flex;align-items:center;gap:12px;padding:0 17px;border:1px solid #303b5a;background:#11182b;border-radius:13px;min-height:54px;color:#a58aff}
.career-picker-search:focus-within{border-color:#8b6cff;box-shadow:0 0 0 3px #8b6cff22}
.career-picker-search input{width:100%;border:0;outline:0;background:transparent;color:#f4f6ff;font:inherit;font-size:13px}
.career-picker-search input::placeholder{color:#7987a8}
.career-picker-count{display:flex;justify-content:space-between;gap:10px;max-width:700px;margin:0 auto 10px;color:#8795b7;font-size:11px}
.career-picker-list{max-width:700px;max-height:46vh;overflow:auto;margin:auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;padding:2px}
.career-picker-option{display:flex;align-items:center;gap:11px;min-width:0;text-align:left;padding:13px;border:1px solid #28334f;border-radius:12px;background:#101729;color:#eaf0ff;cursor:pointer;transition:transform .18s,border-color .18s,background .18s}
.career-picker-option:hover,.career-picker-option.selected{border-color:#8b6cff;background:#1b1a35;transform:translateY(-1px)}
.career-option-symbol{width:36px;height:36px;flex-shrink:0;display:grid;place-items:center;border-radius:10px;background:#8b6cff20;color:#b9a2ff}
.career-option-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:5px}
.career-option-copy b{font-size:12px}
.career-option-copy small{font-size:10px;line-height:1.4;color:#95a3c3}
.career-picker-option>svg{flex-shrink:0;color:#8e9cbb}
.career-empty{grid-column:1/-1;padding:28px;text-align:center;color:#a8b5d2;border:1px dashed #303b5a;border-radius:12px}
@keyframes careerWelcomeIn{from{opacity:0;transform:translateY(18px) scale(.99)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes careerSparkle{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-7px) rotate(3deg)}}
@media(max-width:650px){.career-onboarding{padding:20px 14px}.career-picker{margin-top:30px}.career-picker-list{grid-template-columns:1fr;max-height:48vh}.welcome-animation{padding:40px 8px}.career-picker h1{font-size:34px}.career-picker-count{padding:0 2px}}


/* Profile and separate logout button */
.profile-row {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
}
.profile-row .profile {
  flex: 1;
  min-width: 0;
}
