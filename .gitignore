# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Build output
dist
tmp
out-tsc
*.tsbuildinfo

# Expo / React Native (not used, kept for safety)
.expo
.expo-shared

# Dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
npm-debug.log
yarn-error.log
testem.log

# System files
.DS_Store
Thumbs.db

# Environment variable files - never commit secrets
.env
.env.local
.env.*.local

# pnpm
.pnpm-store
