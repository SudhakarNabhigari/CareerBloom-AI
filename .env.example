# CareerBloom AI — Environment Variables
#
# This app does NOT require any environment variables to run.
# All features work out of the box with the defaults below.
#
# To customize, copy this file to .env in artifacts/career-bloom/
# (or at the project root) and adjust the values.

# Development server port (default: 5000)
# PORT=5000

# Base path for the app (default: /)
# Change this if you deploy to a sub-path, e.g. /careerbloom
# BASE_PATH=/

